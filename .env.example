# Copy to .env if you do not already have one. Never commit real credentials.
QWEN_BASE_URL=https://your-qwen-host.example/v1
QWEN_API_KEY=your-api-key
QWEN_MODEL=your-served-model-name

# Relative paths are resolved from the project root.
PDF_PATH=docs/document.pdf
VECTOR_DB_PATH=data/chromadb
COLLECTION_NAME=document_data

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=5

QWEN_MAX_TOKENS=1024
QWEN_TEMPERATURE=0.2
QWEN_TIMEOUT=120

# Optional Qwen/vLLM extension. Blank omits the field; true/false sends it.
QWEN_ENABLE_THINKING=
